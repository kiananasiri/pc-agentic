---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "Agno Crypto AI Assistant" } = Astro.props;
---

<!usr/bin/env html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content="Agentic Cryptocurrency AI Chatbot powered by Agno framework for Technical Analysis and On-Chain Intelligence." />
  </head>
  <body>
    <slot />
  </body>
</html>
