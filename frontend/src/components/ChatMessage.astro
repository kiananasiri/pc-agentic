---
export interface Props {
  role: 'user' | 'assistant';
  content: string;
  price?: number;
  thinking?: string;
  timestamp?: string;
}

const { role, content, price, thinking } = Astro.props;

// Persian language detector
const isPersian = /[\u0600-\u06FF]/.test(content);
---

<div class={`message-row ${role}`}>
  <div class="avatar glass-card">
    {role === 'user' ? (
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
    ) : (
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8z"></path>
        <circle cx="12" cy="12" r="3"></circle>
      </svg>
    )}
  </div>

  <div class={`message-content glass-card ${isPersian ? 'rtl-text' : 'ltr-text'}`}>
    <div class="message-header">
      <span class="sender-name">{role === 'user' ? 'شما' : 'دستیار Agno AI'}</span>
      {price && (
        <span class="price-badge">${price.toFixed(6)}</span>
      )}
    </div>

    {thinking && (
      <details class="thinking-details" open>
        <summary class="thinking-summary">
          <span class="thinking-icon">🧠</span>
          <span class="thinking-title">روند تفکر ایجنت (Thinking Process)</span>
        </summary>
        <div class="thinking-body" set:html={thinking.replace(/\n/g, '<br/>')} />
      </details>
    )}

    <div class="message-body" set:html={content.replace(/\n/g, '<br/>')} />
  </div>
</div>

<style>
  .message-row {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
    align-items: flex-start;
    direction: rtl;
  }

  .message-row.user {
    flex-direction: row-reverse;
  }

  .avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--accent-cyan);
    background: #0f172a;
    border: 1px solid var(--border-light);
  }

  .message-row.user .avatar {
    color: var(--accent-purple);
    background: rgba(168, 85, 247, 0.15);
    border-color: rgba(168, 85, 247, 0.3);
  }

  .message-content {
    max-width: 80%;
    padding: 1rem 1.25rem;
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid var(--border-light);
  }

  .message-row.user .message-content {
    background: rgba(30, 41, 59, 0.9);
    border-color: rgba(99, 102, 241, 0.3);
  }

  .message-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .sender-name {
    font-weight: 600;
  }

  .price-badge {
    background: #0f172a;
    color: var(--accent-cyan);
    font-family: 'Fira Code', monospace;
    font-size: 0.65rem;
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
    border: 1px solid var(--border-light);
  }

  .message-body {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-main);
  }

  .thinking-details {
    background: rgba(168, 85, 247, 0.08);
    border: 1px solid rgba(168, 85, 247, 0.25);
    border-radius: 8px;
    padding: 0.5rem 0.75rem;
    margin-bottom: 0.75rem;
    font-size: 0.82rem;
  }

  .thinking-summary {
    cursor: pointer;
    font-weight: 600;
    color: #c084fc;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    user-select: none;
  }

  .thinking-body {
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px dashed rgba(168, 85, 247, 0.25);
    color: #e2e8f0;
    font-size: 0.78rem;
    line-height: 1.5;
  }
</style>
