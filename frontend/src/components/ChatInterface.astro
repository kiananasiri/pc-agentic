              </button>
              ${price ? `<span class="price-tag">$${price.toFixed(6)}</span>` : ''}
            </div>
          </div>
        `;

        const btnCopy = row.querySelector('.btn-copy');
        if (btnCopy) {
          btnCopy.addEventListener('click', () => {
            navigator.clipboard.writeText(mainText);
            btnCopy.style.color = '#38bdf8';
            setTimeout(() => { btnCopy.style.color = '#9b9b9b'; }, 1500);
