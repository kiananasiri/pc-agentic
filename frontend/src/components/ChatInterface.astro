          switchToSession(session.id);
        });

        const deleteBtn = item.querySelector('.btn-delete-history');
        if (deleteBtn) {
          deleteBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            e.preventDefault();
            deleteSession(session.id);
          });
        }

        historyEl.appendChild(item);
      });
    }

    function createNewSession(initialTitle = 'گفتگوی جدید') {
      const newSession = {
        id: 'session_' + Date.now() + '_' + Math.random().toString(36).substring(2, 7),
        title: initialTitle,
        createdAt: new Date().toISOString(),
        updatedAt: new Date().toISOString(),
        messages: []
      };
      sessions.unshift(newSession);
      activeSessionId = newSession.id;
      saveSessionsToStorage();
      renderHistoryList();
      renderCurrentSessionMessages();
      return newSession;
    }

    function switchToSession(id) {
      activeSessionId = id;
      saveSessionsToStorage();
      renderHistoryList();
      renderCurrentSessionMessages();
    }

    function deleteSession(id) {
      sessions = sessions.filter(s => s.id !== id);
      if (activeSessionId === id) {
        activeSessionId = sessions.length > 0 ? sessions[0].id : null;
      }
      saveSessionsToStorage();
      renderHistoryList();
      renderCurrentSessionMessages();
    }

    function clearAllSessions() {
      if (sessions.length === 0) return;
      if (!confirm('آیا از حذف تمام گفتگوهای ذخیره شده اطمینان دارید؟')) return;
      sessions = [];
      activeSessionId = null;
      saveSessionsToStorage();
      renderHistoryList();
      renderCurrentSessionMessages();
    }

    // Load & initialize state inside DOMContentLoaded
    loadSessionsFromStorage();
    activeSessionId = localStorage.getItem(ACTIVE_KEY);

    if (sessions.length > 0) {
      if (!activeSessionId || !sessions.some(s => s.id === activeSessionId)) {
        activeSessionId = sessions[0].id;
      }
    } else {
      createNewSession('گفتگوی جدید');
    }

    renderHistoryList();
    renderCurrentSessionMessages();
    renderInlineIndicatorsPanel();

    // Attach Event Listeners
    btnNewChat?.addEventListener('click', () => {
      createNewSession('گفتگوی جدید');
      if (userInput) userInput.value = '';
      currentPayload = null;
      if (payloadBanner) payloadBanner.style.display = 'none';
      if (payloadDot) payloadDot.className = 'status-dot-off';
      if (payloadStatusText) payloadStatusText.textContent = 'بدون دیتاسِت (حالت عمومی)';
    });

    btnClearAllHistory?.addEventListener('click', () => {
      clearAllSessions();
    });

    document.querySelectorAll('.preset-card').forEach(btn => {
      btn.addEventListener('click', () => {
        const preset = btn.getAttribute('data-preset');
        if (preset === 'ta_btc') {
          currentPayload = null;
          // Switch tab to technical mode
          document.querySelectorAll('.mode-tab').forEach(t => t.classList.remove('active'));
          const taTab = document.querySelector('.mode-tab[data-mode="technical"]');
          if (taTab) taTab.classList.add('active');
          activeMode = 'technical';
          selectedTAIds = new Set(TA_INDICATORS.map(i => i.id));
          saveIndicatorsToStorage();
          renderInlineIndicatorsPanel();
          updatePayloadUI("⚡ دیتاسِت زنده امروز (بیت‌کوین - کندل‌ها و اندیکاتورها)");
          userInput.value = "بیت کوین رو تو تایم فریم یک روزه با کندل‌ها و اندیکاتورهای انتخاب شده تحلیل کن و سیگنال بده";
        } else if (preset === 'smart_money') {
          currentPayload = null;
          // Switch tab to fundamental mode
          document.querySelectorAll('.mode-tab').forEach(t => t.classList.remove('active'));
          const faTab = document.querySelector('.mode-tab[data-mode="fundamental"]');
          if (faTab) faTab.classList.add('active');
          activeMode = 'fundamental';
          selectedFAIds = new Set(['smart_money_flow', 'exchange_flow', 'large_holders_netflow']);
          saveIndicatorsToStorage();
          renderInlineIndicatorsPanel();
          updatePayloadUI("⚡ دیتاسِت آن‌چین زنده امروز: جریان پول هوشمند");
          userInput.value = "روند جریان پول هوشمند بیت‌کوین (Smart Money Flow) و خالص ورودی/خروجی صرافی‌ها را تحلیل کن.";
        } else if (preset === 'miner_behavior') {
          currentPayload = null;
          // Switch tab to fundamental mode
          document.querySelectorAll('.mode-tab').forEach(t => t.classList.remove('active'));
          const faTab = document.querySelector('.mode-tab[data-mode="fundamental"]');
          if (faTab) faTab.classList.add('active');
          activeMode = 'fundamental';
          selectedFAIds = new Set(['miner_behavior', 'active_addresses', 'mvrv_ratio']);
          saveIndicatorsToStorage();
          renderInlineIndicatorsPanel();
          updatePayloadUI("⚡ دیتاسِت آن‌چین زنده امروز: رفتار ماینرها");
          userInput.value = "ذخایر و رفتار ماینرهای بیت‌کوین و وضعیت شبکه را تحلیل کن.";
        }
      });
    });

    document.querySelectorAll('.chip').forEach(chip => {
      chip.addEventListener('click', () => {
        userInput.value = chip.getAttribute('data-query');
      });
    });

    document.querySelectorAll('.mode-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.mode-tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        activeMode = tab.getAttribute('data-mode') || 'general';
        currentCode = (activeMode === 'code');

        if (activeMode === 'technical') {
          updatePayloadUI("⚡ حالت زنده: دریافت خودکار قیمت و اندیکاتورهای تکنیکال منتخب");
        } else if (activeMode === 'fundamental') {
          updatePayloadUI("⚡ حالت زنده: دریافت خودکار معیارهای آن‌چین و بنیادین منتخب");
        } else if (activeMode === 'general') {
          if (payloadBanner) payloadBanner.style.display = 'none';
        }
        renderInlineIndicatorsPanel();
      });
    });

    btnClearPayload?.addEventListener('click', () => {
      currentPayload = null;
      if (payloadBanner) payloadBanner.style.display = 'none';
      if (payloadDot) payloadDot.className = 'status-dot-off';
      if (payloadStatusText) payloadStatusText.textContent = 'بدون دیتاسِت (حالت عمومی)';
    });

    btnAttachData?.addEventListener('click', () => {
      currentPayload = null;
      updatePayloadUI("⚡ دریافت خودکار آخرین داده‌های بازار و اندیکاتورهای امروز فعال شد");
    });

    function updatePayloadUI(text) {
      if (payloadBannerText) payloadBannerText.textContent = text;
      if (payloadBanner) payloadBanner.style.display = 'flex';
      if (payloadDot) payloadDot.className = 'status-dot-on';
      if (payloadStatusText) payloadStatusText.textContent = text;
    }

    chatForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const text = userInput.value.trim();
      if (!text) return;

      let activeSession = getActiveSession();
      if (!activeSession) {
        activeSession = createNewSession(generateTitleFromText(text));
      } else if (!activeSession.messages || activeSession.messages.length === 0 || activeSession.title === 'گفتگوی جدید') {
        activeSession.title = generateTitleFromText(text);
      }

      if (welcomeCard) welcomeCard.style.display = 'none';

      // Record user message in active session
      activeSession.messages.push({
        role: 'user',
        text: text,
        timestamp: new Date().toISOString()
      });
      activeSession.updatedAt = new Date().toISOString();
      saveSessionsToStorage();
      renderHistoryList();

      appendMessageToDOM('user', text);
      userInput.value = '';

      const loadingEl = appendLoading();

      const modelSelect = document.getElementById('modelSelect');
      const model = modelSelect ? modelSelect.value : 'gpt-4o-mini';

      const selectedIndicatorsPayload = {
        technical: activeMode === 'technical' ? Array.from(selectedTAIds) : [],
        fundamental: activeMode === 'fundamental' ? Array.from(selectedFAIds) : []
      };

      const payload = {
        question: text,
        model: model,
        code: currentCode,
        selected_indicators: selectedIndicatorsPayload,
        ...(currentPayload?.analysis ? { analysis: currentPayload.analysis } : {}),
        ...(currentPayload?.fundamental ? { analysis_fundamental: currentPayload.fundamental } : {})
      };

      try {
        const response = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await response.json();
        if (loadingEl) loadingEl.remove();

        let assistantText = data.answer || ('خطا در تولید پاسخ: ' + (data.error || 'خطای ناشناخته'));
        let priceVal = data.price || 0;
        let thinkingVal = data.thinking || '';

        activeSession.messages.push({
          role: 'assistant',
          text: assistantText,
          price: priceVal,
          thinking: thinkingVal,
          timestamp: new Date().toISOString()
        });
        activeSession.updatedAt = new Date().toISOString();
        saveSessionsToStorage();
        renderHistoryList();

        appendMessageToDOM('assistant', assistantText, priceVal, thinkingVal);
      } catch (err) {
        if (loadingEl) loadingEl.remove();
        let errMsg = 'خطای ارتباط با سرور: ' + err.message;

        activeSession.messages.push({
          role: 'assistant',
          text: errMsg,
          price: 0,
          thinking: '',
          timestamp: new Date().toISOString()
        });
        activeSession.updatedAt = new Date().toISOString();
        saveSessionsToStorage();
        renderHistoryList();

        appendMessageToDOM('assistant', errMsg);
      }
    });
  });
</script>
