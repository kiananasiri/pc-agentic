    function renderHistoryList() {
      const historyEl = document.getElementById('chatHistoryList');
      if (!historyEl) return;

      if (sessions.length === 0) {
        historyEl.innerHTML = '<div class="empty-history">هنوز گفتگویی ذخیره نشده است</div>';
