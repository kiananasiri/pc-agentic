<script>
  import { marked } from 'marked';

  marked.setOptions({
    breaks: true,
    gfm: true
  });

  function ensureCodeFences(rawText) {
    if (!rawText) return '';
    const parts = rawText.split(/(```[\s\S]*?```)/g);

    const processed = parts.map((part) => {
      if (part.startsWith('```')) return part;
      const lines = part.split('\n');
      const resultLines = [];
      let currentBuffer = [];

      const isCodeLine = (str) => {
        const trimmed = str.trim();
        if (!trimmed) return currentBuffer.length > 0;

        // DO NOT treat Markdown elements as code lines
        if (/^#{1,6}\s/.test(trimmed)) return false;
        if (/^(\*|-|\+|\d+\.)\s/.test(trimmed)) return false;
        if (trimmed.startsWith('|')) return false;

        if (/^(:def|:class|\(\)\w+|\}\w+|:\w+)/.test(trimmed)) return true;
        if (/^(import|from|def|class|return|print|if|elif|else|try|except|finally|while|for|with|pass|raise|assert)\b/.test(trimmed)) return true;
        if (/(df\[|\.rolling\(|\.ewm\(|\.mean\(|\.diff\(|\.shift\(|\.where\(|pd\.|np\.|plt\.|calculate_|rsi|macd)\b/.test(trimmed)) return true;

        return false;
      };

      const flushBuffer = () => {
        if (currentBuffer.length > 0) {
          while (currentBuffer.length > 0 && !currentBuffer[currentBuffer.length - 1].trim()) {
            currentBuffer.pop();
          }

          const hasActualCode = currentBuffer.some(l => {
            const t = l.trim();
            return t && !t.startsWith('#') && /^(import|from|def|class|return|print|if|elif|else|while|for|with|df\[|pd\.|np\.|plt\.)\b/.test(t);
          });

          if (hasActualCode && currentBuffer.length >= 1) {
            const cleanedCode = currentBuffer.join('\n')
              .replace(/^:def\s+/gm, 'def ')
              .replace(/^:class\s+/gm, 'class ')
              .replace(/^\(\)gain\s*=/gm, 'gain =')
              .replace(/^\(\)loss\s*=/gm, 'loss =')
              .replace(/^\(\)delta\s*=/gm, 'delta =')
              .replace(/^\(\)data\[/gm, 'data[')
              .replace(/^\}data\s*=/gm, 'data =')
              .replace(/^\(\{$/gm, '})');

            resultLines.push('\n```python\n' + cleanedCode + '\n```\n');
          } else {
            resultLines.push(currentBuffer.join('\n'));
          }
          currentBuffer = [];
        }
      };

      for (let i = 0; i < lines.length; i++) {
        const line = lines[i];
        if (isCodeLine(line)) {
          currentBuffer.push(line);
        } else {
          flushBuffer();
          resultLines.push(line);
        }
      }
      flushBuffer();
      return resultLines.join('\n');
    });

    return processed.join('');
  }

  function renderMarkdown(rawText) {
    if (!rawText) return '';
    try {
      const formattedText = ensureCodeFences(rawText);
      return marked.parse(formattedText);
    } catch (_err) {
      return rawText.replace(/\n/g, '<br/>');
    }
  }

  function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/[&<>"']/g, function(m) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[m];
    });
  }

  function generateTitleFromText(text) {
    let cleaned = (text || '').trim().replace(/\n/g, ' ');
    if (cleaned.length > 32) {
      cleaned = cleaned.substring(0, 32) + '...';
    }
    return cleaned || 'گفتگوی تحلیلی';
  }

