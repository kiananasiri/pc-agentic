  // Selected sets - ALL items selected by default!
  let selectedTAIds = new Set(TA_INDICATORS.map(i => i.id));
  let selectedFAIds = new Set(FA_INDICATORS.map(i => i.id));

  function loadSessionsFromStorage() {
    try {
      const raw = localStorage.getItem(SESSIONS_KEY);
      sessions = raw ? JSON.parse(raw) : [];
    } catch (e) {
      sessions = [];
    }
  }

  function saveSessionsToStorage() {
    try {
      localStorage.setItem(SESSIONS_KEY, JSON.stringify(sessions));
      if (activeSessionId) {
        localStorage.setItem(ACTIVE_KEY, activeSessionId);
      } else {
        localStorage.removeItem(ACTIVE_KEY);
      }
    } catch (e) {
      console.error('Failed to save sessions to localStorage', e);
    }
  }

  function loadIndicatorsFromStorage() {
    try {
      const raw = localStorage.getItem(INDICATORS_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (Array.isArray(parsed.ta)) selectedTAIds = new Set(parsed.ta);
        if (Array.isArray(parsed.fa)) selectedFAIds = new Set(parsed.fa);
      } else {
        selectedTAIds = new Set(TA_INDICATORS.map(i => i.id));
        selectedFAIds = new Set(FA_INDICATORS.map(i => i.id));
      }
    } catch (e) {
      selectedTAIds = new Set(TA_INDICATORS.map(i => i.id));
      selectedFAIds = new Set(FA_INDICATORS.map(i => i.id));
    }
  }

  function saveIndicatorsToStorage() {
