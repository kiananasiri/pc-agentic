    { id: 'exchange_flow', category: 'smart_money', nameFa: 'خالص ورودی/خروجی صرافی‌ها (Netflow)', descFa: 'سنجش فشار فروش (ورودی) و انباشت (خروجی)', options: 'Exchange Flow' },
    { id: 'large_holders_netflow', category: 'smart_money', nameFa: 'جریان نهنگ‌ها (Large Holders Netflow)', descFa: 'ورودی و خروجی خالص ولت‌های بالای ۱,۰۰۰ BTC', options: 'Whales' },
    { id: 'whale_accumulation', category: 'smart_money', nameFa: 'شاخص انباشت نهنگ‌ها', descFa: 'بررسی میزان تجمیع دارایی در کیف‌پول‌های اصلی', options: 'Accumulation' },
