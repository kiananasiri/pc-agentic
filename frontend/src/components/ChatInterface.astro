---
---

<main class="chat-interface">
  <!-- Messages List -->
  <div class="messages-container" id="messagesContainer">
    <!-- Welcome Card -->
    <div class="welcome-card glass-card" id="welcomeCard">
      <div class="welcome-badge">پورتال تحلیلی Agno AI</div>
      <h2>دستیار هوشمند بازار کریپتو</h2>
      <p>سوالات عمومی بازار، تحلیل تکنیکال کندل‌ها و اندیکاتورها، یا استراتژی‌های درون زنجیره‌ای (On-Chain) را با ایجنت‌های هوشمند بررسی کنید.</p>
      
      <div class="quick-chips">
        <button class="chip" data-query="بیت کوین رو تو تایم فریم یک دقیقه با کندل‌ها و اندیکاتورها تحلیل کن و سیگنال بده">
          📈 تحلیل تکنیکال BTC 1m (آرون + CCI)
        </button>
        <button class="chip" data-query="روند جریان پول هوشمند بیت‌کوین (Smart Money Flow) به چه صورت است؟">
          🐋 تحلیل جریان پول هوشمند (On-Chain)
        </button>
        <button class="chip" data-query="یک اسکریپت پایتون برای محاسبه RSI و MACD با pandas بنویس">
          💻 اسکریپت پایتون معاملات
        </button>
      </div>
    </div>
  </div>

  <!-- Mode & Input Controls -->
  <div class="input-panel glass-card">
    <div class="mode-tabs">
      <button class="mode-tab active" data-mode="general">
        <span>💬 گفتگو عمومی</span>
      </button>
      <button class="mode-tab" data-mode="technical">
        <span>📊 تحلیل تکنیکال</span>
      </button>
      <button class="mode-tab" data-mode="fundamental">
        <span>🔗 آن‌چین / بنیادین</span>
      </button>
      <button class="mode-tab" data-mode="code">
        <span>💻 کدنویسی</span>
      </button>
    </div>

    <!-- Active Payload Info Banner -->
    <div class="payload-banner" id="payloadBanner" style="display: none;">
      <span id="payloadBannerText">دیتاسِت تحلیل تکنیکال متصل شد (BTCUSDT)</span>
      <button id="btnClearPayload" class="btn-clear">حذف دیتاسِت</button>
    </div>

    <!-- Chat Form with Input & Model Selector Side-by-Side -->
    <form id="chatForm" class="chat-form">
      <div class="input-row">
        <textarea
          id="userInput"
          placeholder="سوال خود یا درخواست تحلیل کریپتو را بنویسید..."
          rows="2"
          required
        ></textarea>
      </div>
      
      <div class="form-actions-bar">
        <div class="right-tools">
          <button type="button" id="btnAttachData" class="icon-btn" title="پیوست دیتاسِت نمونه">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
            </svg>
          </button>

          <!-- Model Selector placed directly inside/next to the chat box -->
          <div class="model-select-box">
            <label for="modelSelect">مدل LLM:</label>
            <select id="modelSelect">
              <option value="gpt-4o-mini" selected>gpt-4o-mini (سریع و اقتصادی)</option>
              <option value="gpt-4o">gpt-4o (پرچمدار دقیق)</option>
              <option value="gpt-4.5-preview">gpt-4.5-preview (جدیدترین پرچمدار)</option>
              <option value="o3-mini">o3-mini (استدلالی سریع)</option>
              <option value="o1">o1 (استدلالی پیشرفته)</option>
              <option value="gpt-4.1">gpt-4.1 (نسل جدید 4.1)</option>
              <option value="gpt-4.1-mini">gpt-4.1-mini</option>
            </select>
          </div>
        </div>

        <button type="submit" id="btnSubmit" class="btn-send">
          <span>ارسال درخواست</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
        </button>
      </div>
    </form>
  </div>
</main>

<style>
  .chat-interface {
    flex: 1;
    display: flex;
    flex-direction: column;
    height: calc(100vh - 70px);
    background: var(--bg-main);
    position: relative;
    overflow: hidden;
    direction: rtl;
  }

  .messages-container {
    flex: 1;
    padding: 1.5rem 2rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }

  .welcome-card {
    margin: auto;
    max-width: 620px;
    padding: 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid var(--border-light);
  }

  .welcome-badge {
    background: var(--primary-light);
    color: var(--primary);
    border: 1px solid rgba(6, 182, 212, 0.3);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.3rem 0.8rem;
    border-radius: 9999px;
  }

  .welcome-card h2 {
    font-size: 1.5rem;
    color: var(--text-heading);
  }

  .welcome-card p {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .quick-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-top: 0.5rem;
  }

  .chip {
    background: #1e293b;
    border: 1px solid var(--border-light);
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-md);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-main);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .chip:hover {
    border-color: var(--primary);
    background: rgba(6, 182, 212, 0.15);
    color: var(--primary);
  }

  .input-panel {
    margin: 1rem 2rem;
    padding: 0.85rem 1.25rem;
    border-radius: var(--radius-lg);
    background: rgba(15, 23, 42, 0.9);
    border: 1px solid var(--border-light);
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.4);
  }

  .mode-tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    overflow-x: auto;
  }

  .mode-tab {
    background: transparent;
    border: 1px solid transparent;
    padding: 0.4rem 0.8rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .mode-tab.active {
    background: rgba(6, 182, 212, 0.15);
    color: var(--accent-cyan);
    border-color: rgba(6, 182, 212, 0.3);
  }

  .payload-banner {
    background: rgba(2, 132, 199, 0.2);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.3);
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm);
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .btn-clear {
    background: transparent;
    border: none;
    color: #38bdf8;
    font-weight: 700;
    cursor: pointer;
  }

  .chat-form {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .input-row {
    width: 100%;
  }

  .chat-form textarea {
    width: 100%;
    background: #0f172a;
    color: var(--text-heading);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 0.85rem;
    font-size: 0.9rem;
    font-family: inherit;
    resize: none;
    outline: none;
    transition: border-color 0.2s ease;
    direction: rtl;
  }

  .chat-form textarea:focus {
    border-color: var(--primary);
  }

  .form-actions-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .right-tools {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .icon-btn {
    background: #1e293b;
    border: 1px solid var(--border-light);
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .icon-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  /* Model Selector Dropdown inside input bar */
  .model-select-box {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: #0f172a;
    border: 1px solid var(--border-light);
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-sm);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .model-select-box select {
    background: transparent;
    border: none;
    outline: none;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent-cyan);
    cursor: pointer;
    direction: ltr;
  }

  .btn-send {
    background: linear-gradient(135deg, var(--accent-cyan), var(--accent-indigo));
    color: #ffffff;
    border: none;
    padding: 0.55rem 1.35rem;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-send:hover {
    box-shadow: 0 4px 14px rgba(6, 182, 212, 0.35);
  }

  .thinking-details {
    background: rgba(168, 85, 247, 0.08);
    border: 1px solid rgba(168, 85, 247, 0.25);
    border-radius: 8px;
    padding: 0.55rem 0.85rem;
    margin-bottom: 0.85rem;
    font-size: 0.82rem;
  }

  .thinking-summary {
    cursor: pointer;
    font-weight: 600;
    color: #c084fc;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    user-select: none;
  }

  .thinking-body {
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px dashed rgba(168, 85, 247, 0.25);
    color: #e2e8f0;
    font-size: 0.78rem;
    line-height: 1.65;
  }
</style>

<script>
  let currentPayload = null;
  let currentCode = false;

  const taSample = {
    pair: "BTCUSDT",
    market: "crypto:spot",
    charts: [{
      startDate: "2025-05-01T05:40:53.254Z",
      endDate: "2025-05-03T07:40:53.254Z",
      resolution: "1m",
      ohlcv: [
        { low: 102887.9, high: 102902.7, open: 102902.6, close: 102898.4, volume: 18.642, timestamp: 1746841800000 },
        { low: 102866, high: 102901.6, open: 102898.4, close: 102899.9, volume: 82.579, timestamp: 1746841860000 },
        { low: 102900, high: 102915.5, open: 102900, close: 102915.4, volume: 31.62, timestamp: 1746841920000 }
      ],
      indicators: [
        { symbol: "aroon", fullName: "Aroon Indicator", outputs: { aroon_up: [[1746841920000, 85.7]], aroon_down: [[1746841920000, 14.2]] } },
        { symbol: "cci", fullName: "Commodity Channel Index", outputs: { cci: [[1746841920000, -78.5]] } }
      ]
    }]
  };

  const smartMoneySample = {
    market: "crypto",
    asset: { id: 1, name: "Bitcoin", symbol: "BTC" },
    chain: { id: 1, name: "Bitcoin", symbol: "BTC" },
    startDate: "2024-03-01T00:00:00Z",
    endDate: "2024-03-02T00:00:00Z",
    strategy: "Smart Money Flow",
    data: {
      exchangeFlow: [
        { timestamp: 1709251200000, inflowVolume: 1500000, outflowVolume: 1200000, netflowVolume: 300000 },
        { timestamp: 1709337600000, inflowVolume: 1550000, outflowVolume: 1250000, netflowVolume: 300000 }
      ],
      largeHoldersNetflow: [
        { timestamp: 1709251200000, netflow: 2500000.5 },
        { timestamp: 1709337600000, netflow: 2600000.75 }
      ]
    }
  };

  const minerBehaviorSample = {
    market: "crypto",
    asset: { id: 1, name: "Bitcoin", symbol: "BTC" },
    chain: { id: 1, name: "Bitcoin", symbol: "BTC" },
    strategy: "Miner Behavior",
    data: {
      minerReserve: [
        { timestamp: 1709251200000, reserve: 1800000 },
        { timestamp: 1709337600000, reserve: 1805000 }
      ]
    }
  };

  document.addEventListener('DOMContentLoaded', () => {
    const chatForm = document.getElementById('chatForm');
    const userInput = document.getElementById('userInput');
    const messagesContainer = document.getElementById('messagesContainer');
    const welcomeCard = document.getElementById('welcomeCard');
    const payloadBanner = document.getElementById('payloadBanner');
    const payloadBannerText = document.getElementById('payloadBannerText');
    const btnClearPayload = document.getElementById('btnClearPayload');
    const btnAttachData = document.getElementById('btnAttachData');
    const payloadDot = document.getElementById('payloadDot');
    const payloadStatusText = document.getElementById('payloadStatusText');

    document.querySelectorAll('.preset-card').forEach(btn => {
      btn.addEventListener('click', () => {
        const preset = btn.getAttribute('data-preset');
        if (preset === 'ta_btc') {
          currentPayload = null; // Auto-fetch live market data for BTC
          updatePayloadUI("⚡ دیتاسِت زنده امروز (بیت‌کوین - کندل‌ها و اندیکاتورها)");
          userInput.value = "بیت کوین رو تو تایم فریم یک روزه با کندل‌ها و اندیکاتورهای RSI و MACD تحلیل کن و سیگنال بده";
        } else if (preset === 'smart_money') {
          currentPayload = null; // Auto-fetch live fundamental data
          updatePayloadUI("⚡ دیتاسِت آن‌چین زنده امروز: جریان پول هوشمند");
          userInput.value = "روند جریان پول هوشمند بیت‌کوین (Smart Money Flow) در تاریخ امروز به چه صورت است؟";
        } else if (preset === 'miner_behavior') {
          currentPayload = null; // Auto-fetch live miner behavior
          updatePayloadUI("⚡ دیتاسِت آن‌چین زنده امروز: رفتار ماینرها");
          userInput.value = "ذخایر و رفتار ماینرهای بیت‌کوین را تحلیل کن.";
        }
      });
    });

    document.querySelectorAll('.chip').forEach(chip => {
      chip.addEventListener('click', () => {
        userInput.value = chip.getAttribute('data-query');
      });
    });

    document.querySelectorAll('.mode-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.mode-tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        const mode = tab.getAttribute('data-mode');
        currentCode = (mode === 'code');

        if (mode === 'technical') {
          updatePayloadUI("⚡ حالت زنده: دریافت خودکار تاریخچه قیمت و اندیکاتورهای امروز");
        } else if (mode === 'fundamental') {
          updatePayloadUI("⚡ حالت زنده: دریافت خودکار معیارهای آن‌چین و بنیادین امروز");
        } else if (mode === 'general') {
          if (payloadBanner) payloadBanner.style.display = 'none';
        }
      });
    });

    btnClearPayload?.addEventListener('click', () => {
      currentPayload = null;
      if (payloadBanner) payloadBanner.style.display = 'none';
      if (payloadDot) payloadDot.className = 'status-dot-off';
      if (payloadStatusText) payloadStatusText.textContent = 'بدون دیتاسِت (حالت عمومی)';
    });

    btnAttachData?.addEventListener('click', () => {
      currentPayload = null; // Default to live auto-fetch
      updatePayloadUI("⚡ دریافت خودکار آخرین داده‌های بازار و اندیکاتورهای امروز فعال شد");
    });

    function updatePayloadUI(text) {
      if (payloadBannerText) payloadBannerText.textContent = text;
      if (payloadBanner) payloadBanner.style.display = 'flex';
      if (payloadDot) payloadDot.className = 'status-dot-on';
      if (payloadStatusText) payloadStatusText.textContent = text;
    }

    chatForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const text = userInput.value.trim();
      if (!text) return;

      if (welcomeCard) welcomeCard.style.display = 'none';

      appendMessage('user', text);
      userInput.value = '';

      const loadingEl = appendLoading();

      const modelSelect = document.getElementById('modelSelect');
      const model = modelSelect ? modelSelect.value : 'gpt-4o-mini';

      const payload = {
        question: text,
        model: model,
        code: currentCode,
        ...(currentPayload?.analysis ? { analysis: currentPayload.analysis } : {}),
        ...(currentPayload?.fundamental ? { analysis_fundamental: currentPayload.fundamental } : {})
      };

      try {
        const response = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await response.json();
        loadingEl.remove();

        if (data.answer) {
          appendMessage('assistant', data.answer, data.price, data.thinking);
        } else {
          appendMessage('assistant', 'خطا در تولید پاسخ: ' + (data.error || 'خطای ناشناخته'));
        }
      } catch (err) {
        loadingEl.remove();
        appendMessage('assistant', 'خطای ارتباط با سرور: ' + err.message);
      }
    });

    function appendMessage(role, text, price, thinking) {
      const isPersian = /[\u0600-\u06FF]/.test(text);
      const row = document.createElement('div');
      row.className = `message-row ${role}`;

      let thinkingHtml = '';
      if (thinking) {
        thinkingHtml = `
          <details class="thinking-details" open>
            <summary class="thinking-summary">
              <span class="thinking-icon">🧠</span>
              <span class="thinking-title">روند تفکر ایجنت (Thinking Process)</span>
            </summary>
            <div class="thinking-body">${thinking.replace(/\n/g, '<br/>')}</div>
          </details>
        `;
      }

      row.innerHTML = `
        <div class="avatar glass-card">${role === 'user' ? '👤' : '🤖'}</div>
        <div class="message-content glass-card ${isPersian ? 'rtl-text' : 'ltr-text'}">
          <div class="message-header">
            <span class="sender-name">${role === 'user' ? 'شما' : 'دستیار Agno AI'}</span>
            ${price ? `<span class="price-badge">$${price.toFixed(6)}</span>` : ''}
          </div>
          ${thinkingHtml}
          <div class="message-body">${text.replace(/\n/g, '<br/>')}</div>
        </div>
      `;
      messagesContainer.appendChild(row);
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    function appendLoading() {
      const row = document.createElement('div');
      row.className = 'message-row assistant';
      row.innerHTML = `
        <div class="avatar glass-card">🤖</div>
        <div class="message-content glass-card">
          <div class="message-header"><span class="sender-name">در حال پردازش ایجنت Agno...</span></div>
          <div class="message-body">در حال فراخوانی ابزارهای تحلیلی و بررسی داده‌ها...</div>
        </div>
      `;
      messagesContainer.appendChild(row);
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
      return row;
    }
  });
</script>
