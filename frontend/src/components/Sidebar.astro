---
---

<aside class="app-sidebar">
  <button id="btnNewChat" class="btn-new-chat">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <line x1="12" y1="5" x2="12" y2="19"></line>
      <line x1="5" y1="12" x2="19" y2="12"></line>
    </svg>
    گفتگوی تحلیلی جدید
  </button>

  <div class="sidebar-section history-section">
    <div class="history-header">
      <h3 class="section-title">تاریخچه گفتگوها</h3>
      <button id="btnClearAllHistory" class="btn-clear-all" title="حذف همه گفتگوها">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="3 6 5 6 21 6"></polyline>
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
        </svg>
      </button>
    </div>
    <div class="chat-history-list" id="chatHistoryList">
      <div class="empty-history">هنوز گفتگویی ذخیره نشده است</div>
    </div>
  </div>

  <div class="sidebar-section">
    <h3 class="section-title">سناریوهای آماده ایجنت</h3>
    <div class="preset-list">
      <button class="preset-card" data-preset="ta_btc">
        <div class="preset-icon ta">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
          </svg>
        </div>
        <div class="preset-info">
          <span class="preset-name">تحلیل تکنیکال BTC 1m</span>
          <span class="preset-desc">بررسی Aroon + CCI + KVO</span>
        </div>
      </button>

      <button class="preset-card" data-preset="smart_money">
        <div class="preset-icon fa">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
          </svg>
        </div>
        <div class="preset-info">
          <span class="preset-name">جریان پول هوشمند</span>
          <span class="preset-desc">خالص ورودی/خروجی صرافی‌ها</span>
        </div>
      </button>

      <button class="preset-card" data-preset="miner_behavior">
        <div class="preset-icon miner">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
          </svg>
        </div>
        <div class="preset-info">
          <span class="preset-name">رفتار ماینرها</span>
          <span class="preset-desc">ذخایر و نرخ هش شبکه</span>
        </div>
      </button>
    </div>
  </div>

  <div class="sidebar-section">
    <h3 class="section-title">وضعیت دیتاسِت فعال</h3>
    <div class="payload-badge glass-card" id="payloadStatusCard">
      <span class="status-dot-off" id="payloadDot"></span>
      <span id="payloadStatusText">بدون دیتاسِت (حالت عمومی)</span>
    </div>
  </div>

  <div class="sidebar-footer glass-card">
    <div class="footer-item">
      <span>معماری ایجنت</span>
      <span class="active-badge">Agno Framework</span>
    </div>
    <div class="footer-item">
      <span>اندپوینت API</span>
      <span class="code-span">/api/v1/chat/messages</span>
    </div>
  </div>
</aside>

<style is:global>
  .app-sidebar {
    width: 290px;
    background: #0f172a;
    border-left: 1px solid #1e293b;
    padding: 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    height: calc(100vh - 70px);
    overflow-y: auto;
    direction: rtl;
  }

  .btn-new-chat {
    width: 100%;
    padding: 0.8rem 1rem;
    background: linear-gradient(135deg, #06b6d4, #6366f1);
    color: #ffffff;
    border: none;
    border-radius: var(--radius-md);
    font-weight: 700;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(6, 182, 212, 0.35);
    transition: all 0.2s ease;
  }

  .btn-new-chat:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(6, 182, 212, 0.45);
  }

  .section-title {
    font-size: 0.8rem;
    font-weight: 600;
    color: #94a3b8;
    margin-bottom: 0.75rem;
  }

  .preset-list {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  /* High contrast preset cards */
  .preset-card {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 0.9rem;
    background: #1e293b; /* High contrast dark slate */
    border: 1px solid #334155;
    border-radius: var(--radius-md);
    text-align: right;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .preset-card:hover {
    border-color: #38bdf8;
    background: #334155;
    transform: translateX(-3px);
  }

  .preset-icon {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .preset-icon.ta {
    background: rgba(56, 189, 248, 0.2);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.3);
  }

  .preset-icon.fa {
    background: rgba(52, 211, 153, 0.2);
    color: #34d399;
    border: 1px solid rgba(52, 211, 153, 0.3);
  }

  .preset-icon.miner {
    background: rgba(251, 191, 36, 0.2);
    color: #fbbf24;
    border: 1px solid rgba(251, 191, 36, 0.3);
  }

  .preset-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  /* High contrast readable text */
  .preset-name {
    font-size: 0.88rem;
    font-weight: 700;
    color: #f8fafc !important; /* Pure high contrast white */
  }

  .preset-desc {
    font-size: 0.72rem;
    font-weight: 500;
    color: #cbd5e1 !important; /* Bright clear slate */
  }

  .payload-badge {
    padding: 0.85rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: #f8fafc;
    background: #1e293b;
    border: 1px solid #334155;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .status-dot-off {
    width: 9px;
    height: 9px;
    background: #64748b;
    border-radius: 50%;
  }

  .status-dot-on {
    width: 9px;
    height: 9px;
    background: #34d399;
    border-radius: 50%;
    box-shadow: 0 0 10px #34d399;
  }

  .sidebar-footer {
    margin-top: auto;
    padding: 0.9rem;
    background: #1e293b;
    border: 1px solid #334155;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.78rem;
  }

  .footer-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #cbd5e1;
  }

  .active-badge {
    color: #38bdf8;
    font-weight: 700;
  }

  .code-span {
    font-family: 'Fira Code', monospace;
    font-size: 0.68rem;
    background: #0f172a;
    color: #38bdf8;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    border: 1px solid #334155;
  }

  .history-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .history-header .section-title {
    margin-bottom: 0;
  }

  .btn-clear-all {
    background: transparent;
    border: none;
    color: #64748b;
    cursor: pointer;
    padding: 0.2rem 0.4rem;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .btn-clear-all:hover {
    color: #ef4444;
    background: rgba(239, 68, 68, 0.1);
  }

  .chat-history-list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    max-height: 220px;
    overflow-y: auto;
    padding-left: 0.2rem;
  }

  .chat-history-list::-webkit-scrollbar {
    width: 4px;
  }

  .chat-history-list::-webkit-scrollbar-thumb {
    background: #334155;
    border-radius: 4px;
  }

  .history-item {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: space-between !important;
    padding: 0.55rem 0.75rem !important;
    background: #1e293b !important;
    border: 1px solid #334155 !important;
    border-radius: var(--radius-md) !important;
    cursor: pointer !important;
    transition: all 0.2s ease !important;
    gap: 0.5rem !important;
    user-select: none !important;
    width: 100 !important;
    box-sizing: border-box !important;
  }

  .history-item:hover {
    background: #283548 !important;
    border-color: #475569 !important;
  }

  .history-item.active {
    background: rgba(6, 182, 212, 0.18) !important;
    border-color: #06b6d4 !important;
    box-shadow: 0 0 12px rgba(6, 182, 212, 0.25) !important;
  }

  .history-item-content {
    display: flex !important;
    flex-direction: column !important;
    gap: 0.2rem !important;
    overflow: hidden !important;
    flex: 1 !important;
    min-width: 0 !important; /* Prevents overflow pushing buttons */
    text-align: right !important;
  }

  .history-item-title {
    font-size: 0.8rem !important;
    font-weight: 600 !important;
    color: #f8fafc !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    display: block !important;
    width: 100% !important;
  }

  .history-item-date {
    font-size: 0.65rem !important;
    color: #94a3b8 !important;
    display: block !important;
  }

  .btn-delete-history {
    background: transparent !important;
    border: none !important;
    color: #64748b !important;
    opacity: 0.6 !important;
    padding: 0.3rem !important;
    border-radius: 4px !important;
    cursor: pointer !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: all 0.15s ease !important;
    flex-shrink: 0 !important;
    box-shadow: none !important;
    margin: 0 !important;
  }

  .btn-delete-history svg {
    pointer-events: none !important;
  }

  .history-item:hover .btn-delete-history {
    opacity: 1 !important;
  }

  .btn-delete-history:hover {
    color: #ef4444 !important;
    background: rgba(239, 68, 68, 0.2) !important;
  }

  .empty-history {
    font-size: 0.76rem;
    color: #64748b;
    text-align: center;
    padding: 0.75rem 0.5rem;
    background: rgba(30, 41, 59, 0.4);
    border: 1px dashed #334155;
    border-radius: var(--radius-md);
  }
</style>
